{
  "name": "@orch8.io/expo",
  "version": "0.7.1",
  "orch8NativeVersion": "0.7.1",
  "orch8RuntimeNodeMinVersion": "0.7.2",
  "orch8DelegationMinVersion": "0.7.2",
  "description": "Expo SDK for Orch8 workflow engine \u2014 REST client, React hooks, and native engine bridge",
  "main": "build/index.js",
  "types": "build/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "import": {
        "types": "./build/index.d.ts",
        "default": "./build/index.js"
      },
      "require": {
        "types": "./build/index.d.ts",
        "default": "./build/index.js"
      }
    },
    "./app.plugin.js": "./app.plugin.js",
    "./package.json": "./package.json"
  },
  "files": [
    "build",
    "!build/__tests__",
    "ios",
    "!ios/build",
    "!ios/Pods",
    "android/build.gradle",
    "android/src",
    "plugin",
    "app.plugin.js",
    "expo-module.config.json",
    "CHANGELOG.md",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rm -rf build",
    "typecheck": "tsc --noEmit",
    "prepack": "npm run clean && npm run build"
  },
  "keywords": [
    "orch8",
    "workflow",
    "orchestration",
    "expo",
    "react-native",
    "mobile"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/orch8-io/sdk-expo.git"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "license": "MIT",
  "peerDependencies": {
    "expo": ">=51.0.0",
    "react": ">=18.0.0",
    "react-native": ">=0.74.0"
  },
  "dependencies": {},
  "devDependencies": {
    "@types/react": "^18.0.0",
    "expo": "^52.0.0",
    "expo-modules-core": "^2.0.0",
    "react": "^18.0.0",
    "react-native": "^0.76.0",
    "typescript": "^5.4.0",
    "vitest": "^3.0.0"
  },
  "author": "Orch8",
  "homepage": "https://github.com/orch8-io/sdk-expo#readme",
  "bugs": {
    "url": "https://github.com/orch8-io/sdk-expo/issues"
  }
}
